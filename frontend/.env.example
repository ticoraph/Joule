# Backend API URL (empty in prod, the SPA is served by the same Cloud Run service)
VITE_API_URL=http://localhost:8000

# Firebase web app config (public, not secret) — from the Firebase console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_APP_ID=
